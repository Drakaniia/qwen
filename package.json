{
  "name": "qwin-video-downloader",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "setup": "C:\\Progra~1\\Git\\bin\\bash.exe scripts/install.sh",
    "install:native": "C:\\Progra~1\\Git\\bin\\bash.exe scripts/install.sh",
    "build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\build-extension.ps1 -Target all",
    "build:all": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\build-extension.ps1 -Target all",
    "build:chromium": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\build-extension.ps1 -Target chromium",
    "build:yandex": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\build-extension.ps1 -Target yandex",
    "dev": "vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:native": "python -m pytest tests/native/",
    "lint": "npx eslint src/ && python -m ruff check src/native_host/",
    "lint:js": "npx eslint src/",
    "lint:py": "python -m ruff check src/native_host/",
    "lint:fix": "npx eslint --fix src/ && python -m ruff check --fix src/native_host/",
    "typecheck": "tsc --noEmit",
    "format": "npx prettier --write \"src/**/*.{css,json,ts,tsx}\" \"*.{json,js}\" && python -m ruff format src/native_host/",
    "format:js": "npx prettier --write \"src/**/*.{css,json,ts,tsx}\" \"*.{json,js}\"",
    "format:py": "python -m ruff check --fix src/native_host/ && python -m ruff format src/native_host/"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@preact/signals": "^2.11.3",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/preact": "^3.2.4",
    "@types/chrome": "^0.3.4",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "globals": "^17.6.0",
    "happy-dom": "^20.14.5",
    "preact": "^11.0.0",
    "prettier": "^3.8.4",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "vitest-chrome-mv3": "^1.0.0"
  },
  "dependencies": {
    "motion": "^14.0.0"
  }
}
