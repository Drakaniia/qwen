{
  "name": "qwin-video-downloader",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "\"C:\\Program Files\\Git\\bin\\bash.exe\" scripts/install.sh",
    "install:native": "\"C:\\Program Files\\Git\\bin\\bash.exe\" scripts/install.sh",
    "install:aria2": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\install-aria2.ps1",
    "build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\build-extension.ps1 -Target all",
    "build:all": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\build-extension.ps1 -Target all",
    "build:chromium": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\build-extension.ps1 -Target chromium",
    "build:firefox": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\build-extension.ps1 -Target firefox",
    "build:yandex": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\build-extension.ps1 -Target yandex",
    "build:installer": "powershell -NoProfile -ExecutionPolicy Bypass -File packaging\\build-installer.ps1",
    "build:installer:quick": "powershell -NoProfile -ExecutionPolicy Bypass -File packaging\\build-installer.ps1 -SkipPyInstaller -SkipGo -SkipTools",
    "build:installer:full": "powershell -NoProfile -ExecutionPolicy Bypass -File packaging\\build-installer.ps1",
    "build:pyinstaller": "python -m PyInstaller packaging/pyinstaller.spec --distpath packaging/installer-source/native-host --workpath build/pyinstaller",
    "lint": "npx eslint src/ && python -m ruff check src/native_host/",
    "lint:js": "npx eslint src/",
    "lint:py": "python -m ruff check src/native_host/",
    "lint:fix": "npx eslint --fix src/ && python -m ruff check --fix src/native_host/",
    "format": "npx prettier --write \"src/**/*.{js,css,json}\" \"*.{json,js}\" && python -m ruff format src/native_host/",
    "format:js": "npx prettier --write \"src/**/*.{js,css,json}\" \"*.{json,js}\"",
    "format:py": "python -m ruff check --fix src/native_host/ && python -m ruff format src/native_host/"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "globals": "^17.6.0",
    "prettier": "^3.8.4"
  }
}
