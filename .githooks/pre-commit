#!/usr/bin/env bash
# Pre-commit hook: runs Prettier, Ruff, and ESLint checks on staged files.
# Install: cp .githooks/pre-commit .git/hooks/pre-commit (or set core.hooksPath)

set -e

# Get staged files (relative to repo root)
STAGED=$(git diff --cached --name-only --diff-filter=ACM)
if [ -z "$STAGED" ]; then
  exit 0
fi

JS_FILES=$(echo "$STAGED" | grep -E '\.(js|css|json)$' || true)
PY_FILES=$(echo "$STAGED" | grep -E '\.py$' || true)
SRC_JS=$(echo "$STAGED" | grep -E '^(src|tests)/.*\.js$' || true)

FAIL=0

# Prettier check (JS/CSS/JSON)
if [ -n "$JS_FILES" ]; then
  echo "[pre-commit] Prettier check..."
  if ! npx prettier --check $JS_FILES 2>&1; then
    echo "[pre-commit] Prettier: formatting issues found. Run: npm run format"
    FAIL=1
  fi
fi

# Ruff check + format check (Python)
if [ -n "$PY_FILES" ]; then
  echo "[pre-commit] Ruff lint check..."
  if ! python -m ruff check $PY_FILES 2>&1; then
    echo "[pre-commit] Ruff: lint issues found. Run: python -m ruff check --fix <file>"
    FAIL=1
  fi

  echo "[pre-commit] Ruff format check..."
  if ! python -m ruff format --check $PY_FILES 2>&1; then
    echo "[pre-commit] Ruff: formatting issues found. Run: python -m ruff format <file>"
    FAIL=1
  fi
fi

# ESLint check (src/ and tests/ JS only)
if [ -n "$SRC_JS" ]; then
  echo "[pre-commit] ESLint check..."
  if ! npx eslint $SRC_JS 2>&1; then
    echo "[pre-commit] ESLint: issues found."
    FAIL=1
  fi
fi

exit $FAIL
