{
  "manifest_version": 3,
  "name": "Qwin Video Downloader",
  "version": "1.0.0",
  "minimum_chrome_version": "148",
  "description": "Detects playable video URLs on the current page and sends them to a local yt-dlp helper for downloading.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "key": "",
  "permissions": ["activeTab", "scripting", "downloads", "storage", "webRequest", "nativeMessaging", "tabs", "cookies"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "src/background/background.bundle.js"
  },
  "action": {
    "default_title": "Qwin Video Downloader",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_ui": {
    "page": "src/popup/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/content.bundle.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}
