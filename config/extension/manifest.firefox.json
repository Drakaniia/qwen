{
  "manifest_version": 3,
  "name": "Qwin Video Downloader",
  "version": "1.0.0",
  "description": "Detects playable video URLs on the current page and sends them to a local yt-dlp helper for downloading.",
  "permissions": ["activeTab", "scripting", "downloads", "storage", "webRequest", "nativeMessaging", "tabs", "cookies", "debugger", "tabCapture"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "scripts": ["src/background/background.bundle.js"]
  },
  "action": {
    "default_title": "Qwin Video Downloader",
    "default_popup": "src/popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/content.bundle.js"],
      "css": ["src/shared/qwin_overlay.css"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "qwin-video-downloader@example.com",
      "strict_min_version": "121.0"
    }
  }
}
