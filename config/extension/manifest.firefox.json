{
  "manifest_version": 3,
  "name": "Qwin Video Downloader",
  "version": "1.0.0",
  "description": "Detects playable video URLs on the current page and sends them to a local yt-dlp helper for downloading.",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "storage",
    "webRequest",
    "nativeMessaging",
    "tabs",
    "cookies"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "src/shared/media_candidates.js",
      "src/shared/video_filters.js",
      "src/shared/quality_format.js",
      "src/background/download_state.js",
      "src/background/native_requests.js",
      "src/background/download_fallbacks.js",
      "src/background/download_orchestration.js",
      "src/background/background.js"
    ]
  },
  "action": {
    "default_title": "Qwin Video Downloader",
    "default_popup": "src/popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/shared/media_candidates.js",
        "src/shared/video_filters.js",
        "src/shared/quality_format.js",
        "src/shared/quality_dialog.js",
        "src/shared/video_picker.js",
        "src/content/page_detection.js",
        "src/content/content.js"
      ],
      "css": [
        "src/shared/qwin_overlay.css"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "qwin-video-downloader@example.com",
      "strict_min_version": "121.0"
    }
  }
}
